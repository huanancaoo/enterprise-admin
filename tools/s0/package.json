{
  "name": "@workspace/s0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "schema:auth": "auth generate --config backend/auth-cli.ts --output backend/auth-schema.ts --yes",
    "schema:sql": "drizzle-kit generate --config drizzle.config.ts",
    "test:backend": "tsc --noEmit -p tsconfig.backend.json && vitest run --config vitest.backend.config.mjs",
    "test:stories": "vitest run --config vitest.config.ts",
    "build:stories": "storybook build --config-dir .storybook --output-dir .artifacts/storybook --disable-telemetry",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "i18n:generate": "i18next-cli extract && i18next-cli types",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
