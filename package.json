{
  "name": "enterprise-admin",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "api:openapi": "pnpm --filter api openapi",
    "api:generate": "orval",
    "verify:s0": "pnpm --filter @workspace/s0 verify",
    "verify": "pnpm peers check && pnpm typecheck && pnpm lint && pnpm build && pnpm --filter api test --runInBand && pnpm --filter api test:e2e --runInBand && pnpm verify:s0"
  },
  "devDependencies": {
    "@workspace/typescript-config": "workspace:*",
    "orval": "8.33.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.10.13",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "26.8.2",
    "pnpm": "12.4.1"
  }
}
