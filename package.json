{
  "name": "enterprise-admin",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "pnpm lint:boundaries && turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "api:openapi": "pnpm --filter api openapi",
    "api:generate": "orval",
    "verify:s0": "pnpm --filter @workspace/s0 verify",
    "verify": "pnpm peers check && pnpm verify:s1 && pnpm verify:s0 && pnpm verify:s2",
    "lint:boundaries": "node tools/boundaries/check.mjs",
    "test:unit": "vitest run --config vitest.config.mjs && pnpm --filter api test",
    "build:storybook": "turbo build --filter=storybook",
    "verify:s1": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:api && pnpm test:storybook && pnpm build",
    "test:api": "pnpm --filter api test:e2e",
    "test:storybook": "pnpm --filter storybook test",
    "db:generate": "pnpm --filter @workspace/database db:generate",
    "db:migrate": "pnpm --filter @workspace/database db:migrate",
    "test:database": "pnpm --filter @workspace/database test:database",
    "verify:s2": "pnpm --filter @workspace/database verify:s2",
    "test:isolation": "pnpm --filter @workspace/database test:isolation",
    "verify:s3": "pnpm lint:boundaries && pnpm --filter @workspace/database typecheck && pnpm --filter @workspace/database lint && pnpm test:database"
  },
  "devDependencies": {
    "@workspace/typescript-config": "workspace:*",
    "orval": "8.33.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.10.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "@swc/core": "1.16.2",
    "unplugin-swc": "1.6.0"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "26.8.2",
    "pnpm": "12.4.1"
  }
}
