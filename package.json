{
  "name": "enterprise-admin",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "pnpm lint:boundaries && turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "api:openapi": "turbo build --filter=api && pnpm --filter api openapi",
    "api:generate": "orval",
    "verify": "pnpm peers check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:api && pnpm test:storybook && pnpm test:e2e && pnpm db:check && pnpm test:database && pnpm build && pnpm api:check",
    "lint:boundaries": "node packages/eslint-config/boundaries/check.mjs",
    "test:unit": "turbo build --filter=@workspace/contracts --filter=@workspace/i18n --filter=@workspace/database && vitest run --config vitest.config.mjs --project unit && pnpm --filter api test",
    "build:storybook": "turbo build --filter=storybook",
    "test:api": "turbo build --filter=api && pnpm --filter api test:e2e && vitest run --config vitest.config.mjs --project api",
    "test:storybook": "pnpm --filter storybook test",
    "db:generate": "pnpm --filter @workspace/database db:generate",
    "db:migrate": "pnpm --filter @workspace/database db:migrate",
    "db:check": "pnpm --filter @workspace/database schema:check",
    "test:database": "pnpm --filter @workspace/database test:database",
    "test:isolation": "pnpm --filter @workspace/database test:isolation",
    "test:e2e": "turbo build --filter=api && vitest run --config vitest.config.e2e.mjs",
    "api:check": "node packages/api-client/scripts/check-generated.mjs"
  },
  "devDependencies": {
    "@swc/core": "1.16.2",
    "@workspace/typescript-config": "workspace:*",
    "orval": "8.33.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "testcontainers": "12.1.0",
    "turbo": "2.10.13",
    "typescript": "6.0.3",
    "unplugin-swc": "1.6.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "26.8.2",
    "pnpm": "12.4.1"
  }
}
