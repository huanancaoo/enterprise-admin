{
  "name": "@workspace/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./platform-admin": {
      "types": "./dist/platform-admin.d.ts",
      "default": "./dist/platform-admin.js"
    },
    "./tenant": {
      "types": "./dist/tenant.d.ts",
      "default": "./dist/tenant.js"
    },
    "./repositories/projects": {
      "types": "./dist/repositories/projects.d.ts",
      "default": "./dist/repositories/projects.js"
    },
    "./repositories/audit": {
      "types": "./dist/repositories/audit.d.ts",
      "default": "./dist/repositories/audit.js"
    }
  },
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "schema:auth": "auth generate --config auth.config.ts --output src/schema/auth.ts --yes",
    "db:generate": "pnpm schema:auth && drizzle-kit generate",
    "db:migrate": "node src/migrate.ts",
    "schema:check": "node scripts/check-schema.mjs",
    "test:database": "vitest run",
    "test:compose": "node scripts/verify-compose.mjs",
    "test:isolation": "vitest run test/isolation.test.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "auth": "1.7.5",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@better-auth/i18n": "1.7.5",
    "@workspace/i18n": "workspace:*",
    "@workspace/permissions": "workspace:*",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  }
}
