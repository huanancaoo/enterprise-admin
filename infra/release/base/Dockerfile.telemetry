FROM node:26.8.2-bookworm-slim@sha256:cd9f682fa2885cd1056e830424764158570061c59736a1da836bc3d73df095ae AS node-tool

FROM golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS go-tool
ENV GOTOOLCHAIN=local CGO_ENABLED=0
COPY --from=node-tool /usr/local/bin/node /usr/local/bin/node
COPY --from=node-tool /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

FROM go-tool AS mailpit-build
WORKDIR /src
RUN curl -fsSL https://codeload.github.com/axllent/mailpit/tar.gz/3b41030dbef4574ec92b815cb464fec7b4cfdc15 -o /tmp/source.tar.gz && printf '%s  /tmp/source.tar.gz\n' 8edbfb5aa38e9ee67be73fc21e5a3b68f1e2ec3646d3ad8112c4fa915cdca559 | sha256sum -c - && tar -xzf /tmp/source.tar.gz --strip-components=1
RUN npm ci && npm run package
RUN --mount=type=cache,id=enterprise-release-gomod,target=/go/pkg/mod,sharing=locked --mount=type=cache,id=enterprise-release-gobuild,target=/root/.cache/go-build,sharing=locked go get golang.org/x/net@v0.60.0 golang.org/x/crypto@v0.57.0 golang.org/x/image@v0.45.0 golang.org/x/mod@v0.41.0 && go build -trimpath -buildvcs=false -ldflags '-s -w -X github.com/axllent/mailpit/config.Version=1.30.4' -o /mailpit .

FROM axllent/mailpit:v1.30.4@sha256:5a49a77c5bdbe7c5474450b4f46348d09949df3695257729c93a30369382d4f6 AS mailpit
RUN apk add --no-cache libcrypto3=3.5.9-r0 libssl3=3.5.9-r0
COPY --from=mailpit-build /mailpit /mailpit
LABEL org.opencontainers.image.revision="3b41030dbef4574ec92b815cb464fec7b4cfdc15" org.opencontainers.image.version="1.30.4-framework-security-1"

FROM go-tool AS prometheus-build
WORKDIR /src
RUN curl -fsSL https://codeload.github.com/prometheus/prometheus/tar.gz/5241a27fe3c6983549fccc32f6e65917408c63cd -o /tmp/source.tar.gz && printf '%s  /tmp/source.tar.gz\n' eee7ec029ffdba7d9ee59171cad5ddaff10e71514b0bae1a6fde6dc1ae99e181 | sha256sum -c - && tar -xzf /tmp/source.tar.gz --strip-components=1
RUN npm install --global --allow-scripts=pnpm pnpm@12.11.2
WORKDIR /src/web/ui
RUN pnpm install --frozen-lockfile && bash build_ui.sh --all
WORKDIR /src
ENV GOMAXPROCS=2
# upstream assets-compress 生成 EmbedFS；builtinassets 必须包含正式 UI，不能改为缺失 UI 的运行版本。
RUN --mount=type=cache,id=enterprise-release-gomod,target=/go/pkg/mod,sharing=locked --mount=type=cache,id=enterprise-release-gobuild,target=/root/.cache/go-build,sharing=locked go get golang.org/x/net@v0.60.0 && scripts/compress_assets.sh && go build -p 2 -trimpath -buildvcs=false -tags builtinassets -ldflags '-s -w -X github.com/prometheus/common/version.Version=3.15.0 -X github.com/prometheus/common/version.Revision=5241a27fe3c6983549fccc32f6e65917408c63cd' -o /prometheus ./cmd/prometheus && go build -p 2 -trimpath -buildvcs=false -tags builtinassets -ldflags '-s -w' -o /promtool ./cmd/promtool

FROM prom/prometheus:v3.15.0@sha256:efd719c99d83b060d9daefdcf00360461adf279f45ef5391f8d111892118753e AS prometheus
COPY --from=prometheus-build /prometheus /bin/prometheus
COPY --from=prometheus-build /promtool /bin/promtool
LABEL org.opencontainers.image.revision="5241a27fe3c6983549fccc32f6e65917408c63cd" org.opencontainers.image.version="3.15.0-framework-security-1"

FROM go-tool AS jaeger-build
WORKDIR /src
RUN curl -fsSL https://codeload.github.com/jaegertracing/jaeger/tar.gz/462bb49fcff9af4be9556bf0206d07f5171bd8d7 -o /tmp/source.tar.gz && printf '%s  /tmp/source.tar.gz\n' 74ff87bf31cfc1512b1c309831f9f47319a0291c8ec8ff3cf2956917a0a9847f | sha256sum -c - && tar -xzf /tmp/source.tar.gz --strip-components=1
RUN mkdir -p jaeger-ui && curl -fsSL https://codeload.github.com/jaegertracing/jaeger-ui/tar.gz/f538c58b20fab5ba3973269dcb3f458e84605da3 -o /tmp/ui.tar.gz && printf '%s  /tmp/ui.tar.gz\n' 0d5e8d146d7f76c78e886c96314d5b3d756fc0561b46828357056be81b604f81 | sha256sum -c - && tar -xzf /tmp/ui.tar.gz -C jaeger-ui --strip-components=1
RUN npm install --global --allow-scripts=pnpm pnpm@12.5.1
WORKDIR /src/jaeger-ui
RUN pnpm install --frozen-lockfile && pnpm run build
WORKDIR /src
RUN cp -r jaeger-ui/packages/jaeger-ui/build/* cmd/jaeger/internal/extension/jaegerquery/internal/ui/actual/ && find cmd/jaeger/internal/extension/jaegerquery/internal/ui/actual -type f ! -name .gitignore -exec gzip --no-name {} +
RUN --mount=type=cache,id=enterprise-release-gomod,target=/go/pkg/mod,sharing=locked --mount=type=cache,id=enterprise-release-gobuild,target=/root/.cache/go-build,sharing=locked go get golang.org/x/net@v0.60.0 && go build -trimpath -buildvcs=false -ldflags '-s -w -X github.com/jaegertracing/jaeger/internal/version.commitSHA=462bb49fcff9af4be9556bf0206d07f5171bd8d7 -X github.com/jaegertracing/jaeger/internal/version.latestVersion=v2.22.0' -o /jaeger ./cmd/jaeger

FROM jaegertracing/jaeger:2.22.0@sha256:836b967b5abcf1f7758066aa6b348619267a2f1459f72d472840570f9bd88a17 AS tracing
COPY --from=jaeger-build /jaeger /cmd/jaeger/jaeger-linux
LABEL org.opencontainers.image.revision="462bb49fcff9af4be9556bf0206d07f5171bd8d7" org.opencontainers.image.version="2.22.0-framework-security-1"

FROM go-tool AS collector-build
RUN --mount=type=cache,id=enterprise-release-gomod,target=/go/pkg/mod,sharing=locked go install go.opentelemetry.io/collector/cmd/builder@v0.162.0
COPY infra/release/base/collector-builder.yaml /src/builder.yaml
RUN --mount=type=cache,id=enterprise-release-gomod,target=/go/pkg/mod,sharing=locked --mount=type=cache,id=enterprise-release-gobuild,target=/root/.cache/go-build,sharing=locked mkdir -p /out && /go/bin/builder --config=/src/builder.yaml --skip-compilation
WORKDIR /out/collector
RUN --mount=type=cache,id=enterprise-release-gomod,target=/go/pkg/mod,sharing=locked --mount=type=cache,id=enterprise-release-gobuild,target=/root/.cache/go-build,sharing=locked go get golang.org/x/net@v0.60.0 && go build -trimpath -buildvcs=false -tags grpcnotrace -ldflags '-s -w' -o /otelcol-contrib .

FROM otel/opentelemetry-collector-contrib:0.162.0@sha256:39923a8e431bd1f57be82411999d389fcfe40857492e4365456d97a4c1f74be6 AS otel-collector
COPY --from=collector-build /otelcol-contrib /otelcol-contrib
LABEL org.opencontainers.image.version="0.162.0-framework-security-1"
