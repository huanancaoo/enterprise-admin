# 使用独立的 Compose project；这些随机秘密只进入对应服务，不进入镜像。
POSTGRES_PASSWORD=
APP_MIGRATOR_PASSWORD=
APP_RUNTIME_PASSWORD=
PLATFORM_RUNTIME_PASSWORD=
PLATFORM_DEPLOYER_PASSWORD=
MIGRATION_DATABASE_URL=postgresql://app_migrator:YOUR_PASSWORD@postgres:5432/enterprise_admin
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
EMAIL_PAYLOAD_ENCRYPTION_KEY=
RELEASE_TENANT_PORT=3210
RELEASE_PLATFORM_PORT=3211
RELEASE_MAIL_PORT=8026
RELEASE_TENANT_ORIGIN=http://127.0.0.1:3210
RELEASE_PLATFORM_ORIGIN=http://127.0.0.1:3211
# 发布和回退均填写已验收的不可变 image ID 或 registry digest。
RELEASE_API_IMAGE=
RELEASE_TENANT_IMAGE=
RELEASE_PLATFORM_IMAGE=
RELEASE_MIGRATOR_IMAGE=
# Worker 是每次发布的核心运行时。
RELEASE_WORKER_IMAGE=
# API 与 Worker 从这组值读取同一邀请配额。
INVITATION_ORGANIZATION_HOURLY_LIMIT=100
INVITATION_ACTOR_HOURLY_LIMIT=50
INVITATION_IP_HOURLY_LIMIT=100
FILES_STORAGE_BACKEND=local
# s3 必须显式提供已有私有 bucket 的全部连接配置；Local 使用发行包专属持久卷。
FILES_S3_ENDPOINT=
FILES_S3_REGION=
FILES_S3_BUCKET=
FILES_S3_PREFIX=
FILES_S3_ACCESS_KEY_ID=
FILES_S3_SECRET_ACCESS_KEY=
RELEASE_OTLP_PORT=4318
RELEASE_PROMETHEUS_PORT=9090
RELEASE_TRACING_PORT=16686
