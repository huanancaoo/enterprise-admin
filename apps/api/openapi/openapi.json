  "components": {
    "schemas": {
      "OrganizationSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/components/schemas/OrganizationStatus"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "status"
        ],
        "additionalProperties": false
      },
      "OrganizationStatus": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "SUSPENDED"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ApiErrorCode"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "$ref": "#/components/schemas/SupportedLocale"
          }
        },
        "required": [
          "code",
          "message",
          "requestId",
          "locale"
        ],
        "additionalProperties": false
      },
      "ApiErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "ORGANIZATION_SUSPENDED",
          "AUTHORIZATION_UNAVAILABLE",
          "INTERNAL_ERROR"
        ]
      },
      "SupportedLocale": {
        "type": "string",
        "enum": [
          "zh-CN",
          "en-US",
          "ar"
        ]
      },
      "OrganizationAccess": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE"
            ]
          },
          "authorizationVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "effectiveLocale": {
            "$ref": "#/components/schemas/SupportedLocale"
          }
        },
        "required": [
          "organizationId",
          "status",
          "authorizationVersion",
          "effectiveLocale"
        ],
        "additionalProperties": false
      },
      "CreateProject": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "nullable": true,
            "type": "string"
          },
          "contentLocale": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SupportedLocale"
              }
            ]
          }
        },
        "required": [
          "name",
          "description"
        ],
        "additionalProperties": false
      },
      "ProjectResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
          },
          "status": {
            "$ref": "#/components/schemas/ProjectStatus"
          },
          "contentLocale": {
            "$ref": "#/components/schemas/SupportedLocale"
          },
          "resolvedLocale": {
