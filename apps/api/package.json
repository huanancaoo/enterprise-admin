{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run --config vitest.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs",
    "test:cov": "vitest run --config vitest.config.mjs --coverage",
    "test:debug": "vitest --config vitest.config.mjs --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config vitest.config.e2e.mjs",
    "openapi": "nest build && node dist/openapi/export-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.2",
    "@nestjs/core": "12.0.2",
    "@nestjs/platform-express": "12.0.2",
    "@nestjs/swagger": "12.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "better-auth": "1.7.5",
    "@workspace/database": "workspace:*",
    "@workspace/permissions": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.1",
    "@nestjs/schematics": "12.0.2",
    "@nestjs/testing": "12.0.2",
    "@types/express": "5.0.6",
    "@types/node": "26.5.1",
    "@types/supertest": "7.2.1",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "testcontainers": "12.1.0"
  }
}
