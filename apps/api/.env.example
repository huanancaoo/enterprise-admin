# API 进程环境变量；启动前由运行环境注入，本文件不会自动加载。
PORT=3000
DATABASE_URL=postgresql://app_runtime:YOUR_RUNTIME_PASSWORD@localhost:5432/enterprise_admin
# 对外认证服务地址；本地使用 API 地址，生产填写反向代理后的公开地址。
BETTER_AUTH_URL=http://localhost:3000
# 使用随机生成的至少 32 字符密钥，不可暴露给前端。
BETTER_AUTH_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3200,http://localhost:3201
# Platform 模块独立使用；不向普通租户 Repository 传递。
# PLATFORM_DATABASE_URL=postgresql://platform_runtime:YOUR_PLATFORM_PASSWORD@localhost:5432/enterprise_admin
