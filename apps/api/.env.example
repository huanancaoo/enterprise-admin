# 本地开发复制为 apps/api/.env；Nest CLI 启动时加载，已有进程环境变量优先。
PORT=3000
DATABASE_URL=postgresql://app_runtime:YOUR_RUNTIME_PASSWORD@localhost:5432/enterprise_admin
# Better Auth secondary storage：限流与会话缓存。多实例必须共用同一 Redis。
REDIS_URL=redis://127.0.0.1:6379
# 对外认证服务地址；本地使用 API 地址，生产填写反向代理后的公开地址。
BETTER_AUTH_URL=http://localhost:3000
# 使用随机生成的至少 32 字符密钥，不可暴露给前端。
BETTER_AUTH_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3200,http://localhost:3201
# GitHub OAuth App。Authorization callback URL 为 {BETTER_AUTH_URL}/api/auth/callback/github，并勾选 user:email。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 反代 IP 或 CIDR，逗号分隔。设置后按 Better Auth 从右向左跳过这些跳。留空则只接受单值 X-Real-IP / X-Forwarded-For。源站仍须只对反代可达。
BETTER_AUTH_TRUSTED_PROXIES=
# Platform 模块独立使用；不向普通租户 Repository 传递。
PLATFORM_DATABASE_URL=postgresql://platform_runtime:YOUR_PLATFORM_PASSWORD@localhost:5432/enterprise_admin
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=noreply@localhost
EMAIL_FROM_NAME=Enterprise Admin
# 32 字节，64 位十六进制。生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_PAYLOAD_ENCRYPTION_KEY=
EMAIL_LINK_ORIGIN=http://localhost:3200
EMAIL_DEFAULT_LOCALE=zh-CN
EMAIL_DISPATCH_INTERVAL_MS=1000
EMAIL_RETRY_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_DELAY_MS=200
EMAIL_MESSAGE_TTL_MS=86400000
