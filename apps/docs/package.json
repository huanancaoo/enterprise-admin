{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3300",
    "build": "next build",
    "start": "next start --port 3300",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,css,md,mdx}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "search:sync": "node --env-file-if-exists=.env.local scripts/sync-content.ts .next/server/app/static.json.body",
    "check:content": "node scripts/check-content.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.109",
    "@fumadocs/base-ui": "16.15.12",
    "@fumadocs/language": "0.2.5",
    "@modelcontextprotocol/server": "2.0.0",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@vercel/analytics": "2.0.1",
    "ai": "7.0.106",
    "algoliasearch": "5.59.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "flexsearch": "0.8.212",
    "fumadocs-core": "16.15.12",
    "fumadocs-mdx": "15.4.2",
    "fumadocs-openapi": "12.0.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.12",
    "hast-util-to-jsx-runtime": "2.3.6",
    "lucide-react": "1.46.0",
    "mermaid": "11.17.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-rehype": "11.1.2",
    "shiki": "4.4.3",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "3.0.5",
    "@types/mdx": "2.0.14",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "10.10.0",
    "json-schema-typed": "8.0.2",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
