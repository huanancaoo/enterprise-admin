{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "passThroughEnv": ["GITHUB_TOKEN"],
      "outputs": [".next/**", "!.next/cache/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/apps/api/openapi/openapi.json",
        "$TURBO_ROOT$/apps/api/openapi/auth-openapi.json"
      ]
    }
  }
}
