# 仅 app_runtime 运行身份；不注入迁移、bootstrap 或平台部署凭据。
DATABASE_URL=postgresql://app_runtime:replace-me@localhost:5432/enterprise_admin
REDIS_URL=redis://localhost:6379
WORKER_QUEUE_NAME=organization-tasks
WORKER_QUEUE_PREFIX=jobs
WORKER_ATTEMPTS=3
WORKER_BACKOFF_MS=1000
WORKER_CONCURRENCY=4
WORKER_SHUTDOWN_MS=30000
WORKER_LOCK_DURATION_MS=30000
WORKER_STALLED_INTERVAL_MS=30000
WORKER_MAX_STALLED_COUNT=1
WORKER_PRODUCER_TIMEOUT_MS=5000
